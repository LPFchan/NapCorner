            "value" : "Ukončiť NapCorner"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta NapCorner"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner’dan Çık"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрити NapCorner"
          }
        },
        "vi" : {
          "stringUnit" : {
