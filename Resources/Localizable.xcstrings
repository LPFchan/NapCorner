    "NapCorner lives in the menu bar. Click it to change the corner or how long to hold." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيش NapCorner في شريط القائمة. انقر عليه لتغيير الزاوية أو مدة الإبقاء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner живее в лентата с менюта. Щракнете го, за да смените ъгъла или колко да задържате."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner bydlí na řádku nabídek. Klikněte na něj a změňte roh nebo dobu držení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner bor i menulinjen. Klik på den for at ændre hjørnet eller hvor længe du skal holde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner lebt in der Menüleiste. Klicke darauf, um die Ecke oder die Haltedauer zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner vive en la barra de menús. Haz clic en él para cambiar la esquina o cuánto mantener."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner elab menüüribal. Klõpsa seda, et muuta nurka või hoidmise aega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner asuu valikkorivillä. Klikkaa sitä vaihtaaksesi kulmaa tai pitoaikaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner vit dans la barre des menus. Cliquez dessus pour changer de coin ou de durée de maintien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner मेनू बार में रहता है। कोना या रोकने का समय बदलने के लिए उस पर क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner živi u traci s izbornicima. Kliknite ga da promijenite kut ili trajanje držanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A NapCorner a menüsorban lakik. Kattints rá a sarok vagy a tartási idő módosításához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner vive nella barra dei menu. Fai clic per cambiare l’angolo o quanto tenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCornerはメニューバーにいます。クリックするとコーナーやホールド時間を変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner는 메뉴 막대에 있습니다. 클릭해서 모서리나 머무는 시간을 바꿀 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner bor i menylinjen. Klikk på den for å endre hjørnet eller hvor lenge du holder."
          }
        },
        "nl" : {
          "stringUnit" : {
