          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner живёт в строке меню. Нажмите на него, чтобы сменить угол или время удержания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
