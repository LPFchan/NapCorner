    "Put your display to sleep from a screen corner, without the accidental naps or the instant wake-ups." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع شاشتك في وضع السكون من زاوية الشاشة، بلا غفوات عرضية ولا استيقاظ فوري."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приспивайте дисплея от ъгъл на екрана, без случайни дремки и моментални събуждания."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uspěte obrazovku z rohu, bez nechtěných zdřímnutí a okamžitého probouzení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt skærmen på vågeblus fra et hjørne, uden utilsigtede lure eller øjeblikkelig opvågning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick deinen Bildschirm aus einer Ecke schlafen – ohne versehentliche Nickerchen und ohne sofortiges Aufwachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la pantalla en reposo desde una esquina, sin siestas accidentales ni despertares instantáneos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane ekraan nurgast magama, ilma juhuslike uinakute ja kohese ärkamiseta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita näyttö nukkumaan näytön kulmasta ilman vahingossa tulevia torkkuja tai heti heräämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez votre écran en veille depuis un coin, sans siestes accidentelles ni réveils immédiats."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन के कोने से डिस्प्ले को स्लीप में डालें, बिना अनचाही झपकी या तुरंत जागने के।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uspavajte zaslon iz kuta, bez slučajnih drijemanja i trenutnih buđenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altasd el a kijelzőt egy képernyősarokból, véletlen szunyókálások és azonnali ébredések nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in stop lo schermo da un angolo, senza pisolini accidentali né risvegli immediati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の隅からディスプレイをスリープ。うっかりスリープも、すぐの復帰もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 모서리에서 디스플레이를 잠재우세요. 실수로 잠들거나 바로 깨어나는 일 없이요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett skjermen i dvale fra et hjørne, uten utilsiktede lurer eller umiddelbar oppvåkning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je scherm in slaap vanuit een hoek, zonder per ongeluk dutjes of meteen weer wakker worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usypiaj ekran z narożnika, bez przypadkowych drzemek i natychmiastowych pobudek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque a tela para dormir a partir de um canto, sem cochilos acidentais nem despertares instantâneos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponha o ecrã a dormir a partir de um canto, sem sestas acidentais nem despertares instantâneos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puneți ecranul în repaus dintr-un colț, fără ațipiri accidentale sau treziri instantanee."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усыпляйте дисплей из угла экрана — без случайных засыпаний и мгновенных пробуждений."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uspite obrazovku z rohu, bez nechcených driemkaní a okamžitého prebúdzania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försätt skärmen i vila från ett hörn, utan oavsiktliga tupplurar eller direkta uppvaknanden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranınızı bir köşeden uyutun; kazara şekerlemeler ve anında uyanmalar olmadan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присипляйте дисплей із кута екрана — без випадкових дрімот і миттєвих пробуджень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho màn hình ngủ từ một góc, không còn ngủ nhầm hay thức dậy ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从屏幕角落让显示器睡眠，不会误触打盹，也不会立刻醒来。"
          }
        }
      }
    },
