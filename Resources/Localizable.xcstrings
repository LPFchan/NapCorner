        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner замінює активний кут macOS «Перевести дисплей у режим сну»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner thay thế góc nóng “Đặt màn hình sang chế độ ngủ” của macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner 将取代 macOS 的“将显示器置入睡眠状态”触发角。"
          }
