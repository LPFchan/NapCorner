          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner menü çubuğunda yaşar. Köşeyi ya da bekletme süresini değiştirmek için tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner живе на смузі меню. Клацніть його, щоб змінити кут або час утримання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner nằm trên thanh menu. Bấm vào để đổi góc hoặc thời gian giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner 住在菜单栏中。点按它即可更改角落或停留时长。"
          }
        }
      }
    },
    "NapCorner takes over from macOS’s Put Display to Sleep hot corner." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحل NapCorner محل الزاوية النشطة «وضع شاشة العرض في وضع السكون» في macOS."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner поема активния ъгъл на macOS „Приспиване на дисплея“."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner přebírá aktivní roh macOS „Uspat monitor“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner overtager macOS’ aktive hjørne “Sæt skærmen på vågeblus”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner ersetzt die aktive Ecke „Bildschirm in den Ruhezustand versetzen“ von macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner sustituye la esquina activa «Poner la pantalla en reposo» de macOS."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner asendab macOS-i aktiivse nurga „Pane ekraan unerežiimi“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner korvaa macOS:n aktiivisen kulman ”Laita näyttö nukkumaan”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner remplace le coin actif « Suspendre l’activité du moniteur » de macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner macOS के “डिस्प्ले को स्लीप में डालें” हॉट कॉर्नर की जगह लेता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner preuzima macOS aktivni kut „Stavi zaslon u pripravno stanje”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A NapCorner átveszi a macOS „Kijelző alvó módba helyezése” aktív sarkát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner sostituisce l’angolo attivo «Metti in stop il monitor» di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCornerはmacOSのホットコーナー「ディスプレイをスリープさせる」の代わりになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner가 macOS의 ‘디스플레이를 잠자기로 전환’ 핫 코너를 대신합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner tar over for macOS sitt aktive hjørne «Sett skjermen i dvale»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner neemt de actieve hoek ‘Zet beeldscherm in sluimerstand’ van macOS over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner zastępuje aktywny narożnik macOS „Uśpij monitor”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NapCorner substitui o canto ativo “Colocar o Monitor para Dormir” do macOS."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NapCorner substitui o canto ativo “Pôr o monitor em pausa” do macOS."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner preia colțul activ „Pune monitorul în repaus” din macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner заменяет активный угол macOS «Перевести дисплей в режим сна»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner preberá aktívny roh macOS „Uspať monitor“."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner ersätter macOS aktiva hörn ”Försätt skärmen i vila”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NapCorner, macOS’in “Ekranı Uyut” etkin köşesinin yerini alır."
          }
